{
    "name": "mstudio/contao-googlemaps",
    "type": "contao-bundle",
    "description": "Google Maps Extension for Contao 5.x (Upgrade from delahaye/dlh_googlemaps)",
    "keywords": ["contao", "google maps", "maps", "marker"],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Mstudio",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Mstudio\\ContaoGooglemapsBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Mstudio\\ContaoGooglemapsBundle\\ContaoManager\\Plugin"
    }
}
